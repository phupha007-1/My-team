        "# ============================================\n",
        "# PART 2 : CLASS MEMBER\n",
        "# ============================================\n",
        "\n",
        "class Member:\n",
        "\n",
        "    def __init__(\n",
        "        self,\n",
        "        member_id,\n",
        "        name,\n",
        "        age,\n",
        "        weight_kg,\n",
        "        is_vip=False\n",
        "    ):\n",
        "\n",
        "        self.member_id = member_id\n",
        "        self.name = name\n",
        "        self.age = age\n",
        "        self.weight_kg = weight_kg\n",
        "        self.is_vip = is_vip\n",
        "\n",
        "\n",
        "    def get_member_type(self):\n",
        "\n",
        "        if self.is_vip:\n",
        "            return \"VIP\"\n",
        "\n",
        "        return \"General\"\n",
        "\n",
        "\n",
        "    def __str__(self):\n",
        "\n",
        "        return (\n",
        "            f\"Member ID: {self.member_id} | \"\n",
        "            f\"Name: {self.name} | \"\n",
        "            f\"Age: {self.age} | \"\n",
        "            f\"Weight: {self.weight_kg} kg | \"\n",
        "            f\"Type: {self.get_member_type()}\"\n",
        "        )"
