        "# ============================================\n",
        "# PART 13 : SQL ANALYSIS (ALL 13 QUESTIONS)\n",
        "# ============================================\n",
        "\n",
        "# --------------------------------------------\n",
        "# QUESTION 1\n",
        "# บริการประเภทใดสร้างรายได้รวมมากที่สุด?\n",
        "# --------------------------------------------\n",
        "q1_sql = pd.read_sql_query(\"\"\"\n",
        "    SELECT\n",
        "        service_type,\n",
        "        SUM(price) AS total_revenue\n",
        "    FROM gym_memberships\n",
        "    GROUP BY service_type\n",
        "    ORDER BY total_revenue DESC\n",
        "\"\"\", conn)\n",
        "\n",
        "print(\"QUESTION 1 - SQL\")\n",
        "display(q1_sql)\n",
        "\n",
        "\n",
        "# --------------------------------------------\n",
        "# QUESTION 2\n",
        "# แต่ละบริการมีจำนวนการจองและรายได้รวมเท่าไร?\n",
        "# --------------------------------------------\n",
        "q2_sql = pd.read_sql_query(\"\"\"\n",
        "    SELECT\n",
        "        service_type,\n",
        "        COUNT(booking_id) AS total_bookings,\n",
        "        SUM(price) AS total_revenue\n",
        "    FROM gym_memberships\n",
        "    GROUP BY service_type\n",
        "    ORDER BY total_revenue DESC\n",
        "\"\"\", conn)\n",
        "\n",
        "print(\"QUESTION 2 - SQL\")\n",
        "display(q2_sql)\n",
        "\n",
        "\n",
        "# --------------------------------------------\n",
        "# QUESTION 3\n",
        "# น้ำหนักเฉลี่ยของสมาชิกแต่ละบริการเท่าไร?\n",
        "# --------------------------------------------\n",
        "q3_sql = pd.read_sql_query(\"\"\"\n",
        "    SELECT\n",
        "        service_type,\n",
        "        AVG(weight_kg) AS avg_weight\n",
        "    FROM gym_memberships\n",
        "    GROUP BY service_type\n",
        "    ORDER BY avg_weight DESC\n",
        "\"\"\", conn)\n",
        "\n",
        "print(\"QUESTION 3 - SQL\")\n",
        "display(q3_sql)\n",
        "\n",
        "\n",
        "# --------------------------------------------\n",
        "# QUESTION 4\n",
        "# บริการประเภทใดมีค่าเฉลี่ยรายได้ต่อการจอง (Average Revenue per Booking) สูงที่สุด?\n",
        "# --------------------------------------------\n",
        "q4_sql = pd.read_sql_query(\"\"\"\n",
        "    SELECT\n",
        "        service_type,\n",
        "        AVG(price) AS avg_revenue_per_booking\n",
        "    FROM gym_memberships\n",
        "    GROUP BY service_type\n",
        "    ORDER BY avg_revenue_per_booking DESC\n",
        "\"\"\", conn)\n",
        "\n",
        "print(\"QUESTION 4 - SQL\")\n",
        "display(q4_sql)\n",
        "\n",
        "\n",
        "# --------------------------------------------\n",
        "# QUESTION 5\n",
        "# การกระจายตัวของน้ำหนักลูกค้า (ค่าน้อยสุด, ค่ากลาง, ค่ามากสุด) ในแต่ละบริการเป็นอย่างไร?\n",
        "# --------------------------------------------\n",
        "q5_sql = pd.read_sql_query(\"\"\"\n",
        "    SELECT\n",
        "        service_type,\n",
        "        MIN(weight_kg) AS min_weight,\n",
        "        AVG(weight_kg) AS avg_weight, -- ใช้ AVG แทน Median เนื่องจาก SQL มาตรฐานไม่มีฟังก์ชัน MEDIAN ตรงๆ\n",
        "        MAX(weight_kg) AS max_weight\n",
        "    FROM gym_memberships\n",
        "    GROUP BY service_type\n",
        "\"\"\", conn)\n",
        "\n",
        "print(\"QUESTION 5 - SQL\")\n",
        "display(q5_sql)\n",
        "\n",
        "\n",
        "# --------------------------------------------\n",
        "# QUESTION 6\n",
        "# บริการประเภทใดมีสัดส่วนรายได้ (Revenue Share %) คิดเป็นกี่เปอร์เซ็นต์ของรายได้รวมทั้งหมด?\n",
        "# --------------------------------------------\n",
        "q6_sql = pd.read_sql_query(\"\"\"\n",
        "    SELECT\n",
        "        service_type,\n",
        "        SUM(price) AS total_revenue,\n",
        "        (SUM(price) * 100.0 / (SELECT SUM(price) FROM gym_memberships)) AS revenue_share_percent\n",
        "    FROM gym_memberships\n",
        "    GROUP BY service_type\n",
        "    ORDER BY revenue_share_percent DESC\n",
        "\"\"\", conn)\n",
        "\n",
        "print(\"QUESTION 6 - SQL\")\n",
        "display(q6_sql)\n",
        "\n",
        "\n",
        "# --------------------------------------------\n",
        "# QUESTION 7\n",
        "# หากจัดกลุ่มตามบริการ ราคาตั๋วที่ถูกที่สุดและแพงที่สุดของแต่ละบริการคือเท่าไร?\n",
        "# --------------------------------------------\n",
        "q7_sql = pd.read_sql_query(\"\"\"\n",
        "    SELECT\n",
        "        service_type,\n",
        "        MIN(price) AS min_price,\n",
        "        MAX(price) AS max_price\n",
        "    FROM gym_memberships\n",
        "    GROUP BY service_type\n",
        "\"\"\", conn)\n",
        "\n",
        "print(\"QUESTION 7 - SQL\")\n",
        "display(q7_sql)\n",
        "\n",
        "\n",
        "# --------------------------------------------\n",
        "# QUESTION 8\n",
        "# บริการใดที่มีกลุ่มลูกค้าที่น้ำหนักตัวค่อนข้างหลากหลายสูง (ดูจากค่าเบี่ยงเบนมาตรฐาน - SD)?\n",
        "# --------------------------------------------\n",
        "q8_sql = pd.read_sql_query(\"\"\"\n",
        "    SELECT\n",
        "        service_type,\n",
        "        STDDEV(weight_kg) AS weight_std_dev\n",
        "    FROM gym_memberships\n",
        "    GROUP BY service_type\n",
        "    ORDER BY weight_std_dev DESC\n",
        "\"\"\", conn)\n",
        "\n",
        "print(\"QUESTION 8 - SQL\")\n",
        "display(q8_sql)\n",
        "\n",
        "\n",
        "# --------------------------------------------\n",
        "# QUESTION 9\n",
        "# รายการจองที่มีราคาสูงกว่าค่าเฉลี่ยของทั้งบริษัท (Above Average Price) มีจำนวนกี่รายการในแต่ละบริการ?\n",
        "# --------------------------------------------\n",
        "q9_sql = pd.read_sql_query(\"\"\"\n",
        "    SELECT\n",
        "        service_type,\n",
        "        COUNT(booking_id) AS above_average_bookings\n",
        "    FROM gym_memberships\n",
        "    WHERE price > (SELECT AVG(price) FROM gym_memberships)\n",
        "    GROUP BY service_type\n",
        "    ORDER BY above_average_bookings DESC\n",
        "\"\"\", conn)\n",
        "\n",
        "print(\"QUESTION 9 - SQL\")\n",
        "display(q9_sql)\n",
        "\n",
        "\n",
        "# --------------------------------------------\n",
        "# QUESTION 10\n",
        "# ลูกค้าที่มีน้ำหนักเกิน 70 กิโลกรัม นิยมจองบริการประเภทใดมากที่สุด?\n",
        "# --------------------------------------------\n",
        "q10_sql = pd.read_sql_query(\"\"\"\n",
        "    SELECT\n",
        "        service_type,\n",
        "        COUNT(booking_id) AS bookings_weight_over_70\n",
        "    FROM gym_memberships\n",
        "    WHERE weight_kg > 70\n",
        "    GROUP BY service_type\n",
        "    ORDER BY bookings_weight_over_70 DESC\n",
        "\"\"\", conn)\n",
        "\n",
        "print(\"QUESTION 10 - SQL\")\n",
        "display(q10_sql)\n",
        "\n",
        "\n",
        "# --------------------------------------------\n",
        "# QUESTION 11\n",
        "# บริการประเภทใดทำรายได้รวมทะลุ 260,000 บาทบ้าง? (ใช้การกรองหลัง Groupby ด้วย HAVING)\n",
        "# --------------------------------------------\n",
        "q11_sql = pd.read_sql_query(\"\"\"\n",
        "    SELECT\n",
        "        service_type,\n",
        "        SUM(price) AS total_revenue\n",
        "    FROM gym_memberships\n",
        "    GROUP BY service_type\n",
        "    HAVING SUM(price) > 260000\n",
        "    ORDER BY total_revenue DESC\n",
        "\"\"\", conn)\n",
        "\n",
        "print(\"QUESTION 11 - SQL\")\n",
        "display(q11_sql)\n",
        "\n",
        "\n",
        "# --------------------------------------------\n",
        "# QUESTION 12\n",
        "# เปรียบเทียบราคาเฉลี่ยสูงสุด-ต่ำสุด เพื่อดูระดับราคาของบริการส่วนใหญ่\n",
        "# --------------------------------------------\n",
        "q12_sql = pd.read_sql_query(\"\"\"\n",
        "    SELECT\n",
        "        service_type,\n",
        "        AVG(price) AS avg_price,\n",
        "        MIN(price) AS min_price,\n",
        "        MAX(price) AS max_price\n",
        "    FROM gym_memberships\n",
        "    GROUP BY service_type\n",
        "    ORDER BY avg_price DESC\n",
        "\"\"\", conn)\n",
        "\n",
        "print(\"QUESTION 12 - SQL\")\n",
        "display(q12_sql)\n",
        "\n",
        "\n",
        "# --------------------------------------------\n",
        "# QUESTION 13\n",
        "# สรุปภาพรวมเชิงสถิติของราคา (Price) และน้ำหนัก (Weight) แยกตามประเภทบริการในตารางเดียว\n",
        "# --------------------------------------------\n",
        "q13_sql = pd.read_sql_query(\"\"\"\n",
        "    SELECT\n",
        "        service_type,\n",
        "        COUNT(price) AS total_bookings,\n",
        "        SUM(price) AS total_revenue,\n",
        "        AVG(price) AS avg_price,\n",
        "        AVG(weight_kg) AS avg_weight,\n",
        "        STDDEV(weight_kg) AS weight_std_dev\n",
        "    FROM gym_memberships\n",
        "    GROUP BY service_type\n",
        "\"\"\", conn)\n",
        "\n",
        "print(\"QUESTION 13 - SQL\")\n",
        "display(q13_sql)"
      ],
