        "            \"original_price\",\n",
        "            \"sum\"\n",
        "        ),\n",
        "\n",
        "        total_discount=(\n",
        "            \"discount\",\n",
        "            \"sum\"\n",
        "        ),\n",
        "\n",
        "        total_final_price=(\n",
        "            \"final_price\",\n",
        "            \"sum\"\n",
        "        )\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"VIP DISCOUNT SUMMARY\"\n",
        ")\n",
        "\n",
