        "vip_discount_sql = pd.read_sql_query(\"\"\"\n",
        "\n",
        "    SELECT\n",
        "\n",
        "        b.booking_id,\n",
        "\n",
        "        m.name\n",
        "        AS member_name,\n",
        "\n",
        "        CASE\n",
        "\n",
        "            WHEN m.is_vip = 1\n",
        "            THEN 'VIP'\n",
        "\n",
        "            ELSE 'General'\n",
        "\n",
        "        END\n",
        "        AS member_type,\n",
        "\n",
        "        b.price\n",
        "        AS original_price,\n",
        "\n",
        "        CASE\n",
        "\n",
        "            WHEN m.is_vip = 1\n",
        "            THEN b.price * 0.10\n",
        "\n",
        "            ELSE 0\n",
        "\n",
        "        END\n",
        "        AS discount,\n",
        "\n",
        "        CASE\n",
        "\n",
        "            WHEN m.is_vip = 1\n",
        "            THEN b.price * 0.90\n",
        "\n",
        "            ELSE b.price\n",
        "\n",
        "        END\n",
        "        AS final_price\n",
        "\n",
        "    FROM membership_bookings b\n",
        "\n",
        "    JOIN members m\n",
        "\n",
        "        ON b.member_id = m.member_id\n",
        "\n",
        "    ORDER BY b.booking_id\n",
        "\n",
        "\"\"\", conn)\n",
        "\n",
        "\n",
        "display(\n",
        "    vip_discount_sql.head(10)\n",
        ")"
